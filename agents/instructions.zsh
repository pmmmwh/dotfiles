#!/usr/bin/env -S zsh -f

# Deploys agents/instructions to every harness and profile in profiles.toml.
# The base AGENTS.md and rules/ apply everywhere, and <profile>/rules/ adds to one profile.
# Claude loads rules/ itself, so it gets links. The others read one file, so they get it rendered.
#   --dry-run  print what would change

() {
  local SCRIPT_DIR=$(cd $(dirname "${(%):-%x}") && pwd)
  local source_dir=$SCRIPT_DIR/instructions
  local marker='<!-- Generated by agents/instructions.zsh; edit agents/instructions instead -->'
  local dry_run=0

  local arg
  for arg; do
    case $arg in
      --dry-run) dry_run=1 ;;
      *) print -u2 "Unknown option: $arg"; exit 2 ;;
    esac
  done

  local tool
  for tool in yq jq; do
    command -v $tool >/dev/null || { print -u2 "$tool is required"; exit 1 }
  done

  # A real file that something else wrote is left alone
  link_source() {
    if [[ -e $2 && ! -L $2 ]]; then
      print -u2 "skipped: $2 is not a link"
      return
    fi
    ln -sfn $1 $2
  }

  local profiles=$(yq -p toml -o json '.' $SCRIPT_DIR/profiles.toml)

  local entry harness profile config file rules_dir rule link
  local -a rules
  for entry in $(jq -r 'to_entries[] | select(.value.instructions) | .key as $h | .value | to_entries[] | select(.value | type == "object") | "\($h):\(.key)"' <<<$profiles); do
    harness=${entry%%:*} profile=${entry#*:}
    config=$(jq -r --arg h $harness --arg p $profile '.[$h][$p] | .config // .dir' <<<$profiles)
    config=${config/#\~/$HOME}
    file=$config/$(jq -r --arg h $harness '.[$h].instructions' <<<$profiles)
    rules_dir=$(jq -r --arg h $harness '.[$h].rules // empty' <<<$profiles)
    rules=($source_dir/rules/*.md(N) $source_dir/$profile/rules/*.md(N))

    print -r -- "==> $harness:$profile ($file)"
    if [[ -n $rules_dir ]]; then
      if (( dry_run )); then
        print -r -- "link $file and ${#rules} rules in $config/$rules_dir"
        continue
      fi
      mkdir -p $config/$rules_dir
      link_source $source_dir/AGENTS.md $file
      for rule in $rules; do
        link_source $rule $config/$rules_dir/${rule:t}
      done
      # Only links into the source are touched
      for link in $config/$rules_dir/*(N@); do
        [[ ${link:A} == $source_dir/* ]] && (( ! ${rules[(Ie)${link:A}]} )) && rm -- $link
      done
    else
      if [[ -f $file && ! -L $file && $(head -n1 $file) != $marker ]]; then
        print -u2 "skipped: $file was not generated here"
        continue
      fi
      local content=$(print -r -- $marker; print; cat $source_dir/AGENTS.md; for rule in $rules; do print; cat $rule; done)
      if (( dry_run )); then
        print -r -- "render $file ($#content characters, ${#rules} rules)"
        continue
      fi
      mkdir -p ${file:h}
      rm -f -- $file
      print -r -- $content >$file
    fi
  done
} "$@"
