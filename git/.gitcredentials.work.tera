[user]

	# Email, name and signing key in git commits
	email = {{ vars.git_work_email }}
	name = {{ vars.git_name }}
{%- if os() == "macos" %}
{%- if not vars.git_work_signing_key %}{{ throw(message="git_work_signing_key is empty: run `mise run signing-keys` on macOS and bootstrap again; elsewhere, `mise vars prompt git_work_signing_key`") }}{%- endif %}
	# Sign using a key reference; resolved via the Secure Enclave key in ssh-agent
	signingKey = key::{{ vars.git_work_signing_key }}
{%- else %}
	# Using a key file; 1Password signer is not available on servers
	signingKey = {{ env.HOME }}/.ssh/id_ed25519_signing
{%- endif %}
