[user]

	# Email, name and signing key in git commits
	email = {{ vars.git_work_email }}
	name = {{ vars.git_name }}
{%- if os() == "macos" %}
{%- set signing_key = env.HOME ~ "/.ssh/git-signing-work.pub" %}
{%- if signing_key is file %}
	# Sign using a key reference; resolved via the Secure Enclave key in ssh-agent
	signingKey = key::{{ read_file(path=signing_key) | trim }}
{%- endif %}
{%- else %}
	# Using a key file; 1Password signer is not available on servers
	signingKey = {{ env.HOME }}/.ssh/id_ed25519_signing
{%- endif %}
