[user]

	# Email, name and signing key in git commits
	email = {{ vars.git_personal_email }}
	name = {{ vars.git_name }}
{%- if os() == "macos" %}
	signingKey = key::{{ vars.git_personal_signing_key }}
{%- else %}
	# Sign with a key file, as servers have no 1Password and agents cannot approve a prompt
	signingKey = {{ env.HOME }}/.ssh/id_ed25519_signing
{%- endif %}
