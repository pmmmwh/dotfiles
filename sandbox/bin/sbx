#!/usr/bin/env bash
# Per-session Docker sandboxes: one throwaway clone and one container per session.
set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
DOTFILES=${SBX_DOTFILES:-$(dirname "$(dirname "$(dirname "$SELF")")")}
IMAGE=${SBX_IMAGE:-sbx-base:latest}
NETWORK=${SBX_NETWORK:-sbx}
REPOS_DIR=${SBX_REPOS_DIR:-$HOME/Developer}
SANDBOX_DIR=${SBX_DIR:-$HOME/sandboxes}
ENV_FILE=${SBX_ENV_FILE:-$HOME/.config/sbx/env}
MEMORY=${SBX_MEMORY:-1536m}
CPUS=${SBX_CPUS:-1.5}

die() {
  echo "sbx: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: sbx <command> [args]

  build                                Build the sandbox image from the dotfiles
  shell [-s SESSION] [-b BASE] REPO [-- CMD...]
                                       Open a shell in the session's sandbox, creating it if needed
  ls                                   List sandboxes
  path REPO SESSION                    Print the host path of a session's clone
  fetch REPO SESSION                   Fetch a session's branches into REPO as sbx/SESSION/* remote refs
  rm [-f] REPO SESSION                 Remove a sandbox and its clone
  gc [--days N] [--yes]                Remove sandboxes idle for N days (default 7) that hold no unsaved work

REPO is a path under $SBX_REPOS_DIR (default ~/Developer), or absolute.
Secrets for the sandbox (e.g. ANTHROPIC_API_KEY, GH_TOKEN) go in $SBX_ENV_FILE (default ~/.config/sbx/env).
EOF
}

resolve_repo() {
  local arg=$1 path root
  if [[ $arg == /* ]]; then path=$arg; else path=$REPOS_DIR/$arg; fi
  [[ -e $path/.git ]] || die "not a git repository: $path"
  CANONICAL=$(cd "$path" && pwd -P)
  root=$(cd "$REPOS_DIR" 2>/dev/null && pwd -P || echo "$REPOS_DIR")
  local rel=${CANONICAL#"$root"/}
  if [[ $rel == "$CANONICAL" ]]; then rel=$(basename "$CANONICAL"); fi
  SLUG=${rel//\//-}
}

sanitize_session() {
  local session=${1//[^A-Za-z0-9_.-]/-}
  [[ -n $session ]] || die "empty session name"
  echo "$session"
}

container_name() {
  echo "sbx-$1-$2"
}

container_state() {
  docker inspect -f '{{.State.Status}}' "$1" 2>/dev/null || true
}

unsaved_work() {
  local dir=$1
  if [[ -n $(git -C "$dir" status --porcelain) ]]; then
    echo "uncommitted changes"
  elif [[ -n $(git -C "$dir" log --branches --not --remotes --oneline -n 1) ]]; then
    echo "unpushed commits"
  fi
}

remove_sandbox() {
  local slug=$1 session=$2
  docker rm -f "$(container_name "$slug" "$session")" >/dev/null 2>&1 || true
  rm -rf "${SANDBOX_DIR:?}/$slug/$session"
  rmdir "$SANDBOX_DIR/$slug" 2>/dev/null || true
}

cmd_build() {
  secret_file=$(mktemp)
  trap 'rm -f "$secret_file"' EXIT
  local token=${GH_TOKEN:-${GITHUB_TOKEN:-$(gh auth token 2>/dev/null || true)}}
  printf '%s' "$token" >"$secret_file"
  docker build \
    --file "$DOTFILES/sandbox/Dockerfile" \
    --build-arg "USER_UID=$(id -u)" \
    --build-arg "USER_GID=$(id -g)" \
    --secret "id=gh_token,src=$secret_file" \
    --tag "$IMAGE" \
    "$DOTFILES"
  docker builder prune --force --reserved-space 2GB >/dev/null
}

cmd_shell() {
  local session=${SBX_SESSION:-} base="" repo=""
  local -a command=()
  while (($#)); do
    case $1 in
      -s | --session) session=${2:?missing session}; shift 2 ;;
      -b | --base) base=${2:?missing base}; shift 2 ;;
      --) shift; command=("$@"); break ;;
      -*) die "unknown option: $1" ;;
      *) [[ -z $repo ]] || die "unexpected argument: $1"; repo=$1; shift ;;
    esac
  done
  [[ -n $repo ]] || die "missing REPO"
  resolve_repo "$repo"
  session=$(sanitize_session "${session:-$(date +%y%m%d-%H%M%S)}")

  local dir=$SANDBOX_DIR/$SLUG/$session
  if [[ ! -e $dir/.git ]]; then
    local url
    url=$(git -C "$CANONICAL" remote get-url origin 2>/dev/null || true)
    mkdir -p "$SANDBOX_DIR/$SLUG"
    if [[ -n $url ]]; then
      git clone --quiet --reference-if-able "$CANONICAL" --dissociate "$url" "$dir"
    else
      git clone --quiet --local "$CANONICAL" "$dir"
    fi
    git -C "$dir" checkout --quiet -b "sbx/$session" ${base:+"$base"}
  fi
  touch "$dir/.git/sbx-last-used"

  local name state
  name=$(container_name "$SLUG" "$session")
  state=$(container_state "$name")
  case $state in
    running) ;;
    "") start_container "$name" "$dir" ;;
    *) docker start "$name" >/dev/null ;;
  esac

  local -a exec_flags=(-i -e TERM -e COLORTERM)
  if [[ -t 0 && -t 1 ]]; then exec_flags+=(-t); fi
  ((${#command[@]})) || command=(zsh -l)
  exec docker exec "${exec_flags[@]}" "$name" "${command[@]}"
}

start_container() {
  local name=$1 dir=$2
  docker network inspect "$NETWORK" >/dev/null 2>&1 \
    || die "network '$NETWORK' is missing, so egress is unrestricted; run: sudo \"\$(command -v sbx-firewall)\" install"
  local git_name=${SBX_GIT_NAME:-$(git -C "$CANONICAL" config user.name || true)}
  local git_email=${SBX_GIT_EMAIL:-$(git -C "$CANONICAL" config user.email || true)}

  local -a flags=(
    --detach --init
    --name "$name"
    --hostname "$name"
    --network "$NETWORK"
    --label sbx=1
    --memory "$MEMORY"
    --cpus "$CPUS"
    --pids-limit 2048
    --cap-drop ALL
    --security-opt no-new-privileges
    --volume "$dir:/work"
    --volume sbx-cache:/home/agent/.cache
    --volume sbx-npm:/home/agent/.npm
    # Signing keys are not available in the sandbox
    --env "GIT_CONFIG_PARAMETERS='commit.gpgsign=false' 'tag.gpgsign=false'"
  )
  if [[ -n $git_name ]]; then
    flags+=(--env "GIT_AUTHOR_NAME=$git_name" --env "GIT_COMMITTER_NAME=$git_name")
  fi
  if [[ -n $git_email ]]; then
    flags+=(--env "GIT_AUTHOR_EMAIL=$git_email" --env "GIT_COMMITTER_EMAIL=$git_email")
  fi
  if [[ -f $ENV_FILE ]]; then flags+=(--env-file "$ENV_FILE"); fi

  docker run "${flags[@]}" "$IMAGE" >/dev/null
}

cmd_ls() {
  printf '%-28s %-18s %-10s %s\n' REPO SESSION STATE LAST-USED
  local dir slug session state last
  for dir in "$SANDBOX_DIR"/*/*/; do
    [[ -e $dir/.git ]] || continue
    dir=${dir%/}
    session=$(basename "$dir")
    slug=$(basename "$(dirname "$dir")")
    state=$(container_state "$(container_name "$slug" "$session")")
    last=$(date -d "@$(stat -c %Y "$dir/.git/sbx-last-used" 2>/dev/null || stat -c %Y "$dir")" '+%Y-%m-%d %H:%M')
    printf '%-28s %-18s %-10s %s\n' "$slug" "$session" "${state:-none}" "$last"
  done
}

cmd_path() {
  [[ $# -eq 2 ]] || die "usage: sbx path REPO SESSION"
  resolve_repo "$1"
  local session dir
  session=$(sanitize_session "$2")
  dir=$SANDBOX_DIR/$SLUG/$session
  [[ -e $dir/.git ]] || die "no such sandbox: $SLUG/$session"
  echo "$dir"
}

cmd_fetch() {
  [[ $# -eq 2 ]] || die "usage: sbx fetch REPO SESSION"
  local dir session
  resolve_repo "$1"
  session=$(sanitize_session "$2")
  dir=$SANDBOX_DIR/$SLUG/$session
  [[ -e $dir/.git ]] || die "no such sandbox: $SLUG/$session"
  git -C "$CANONICAL" fetch "$dir" "+refs/heads/*:refs/remotes/sbx/$session/*"
}

cmd_rm() {
  local force=0
  if [[ ${1:-} == -f ]]; then force=1; shift; fi
  [[ $# -eq 2 ]] || die "usage: sbx rm [-f] REPO SESSION"
  local dir session reason
  resolve_repo "$1"
  session=$(sanitize_session "$2")
  dir=$SANDBOX_DIR/$SLUG/$session
  [[ -e $dir/.git ]] || die "no such sandbox: $SLUG/$session"
  reason=$(unsaved_work "$dir")
  if [[ -n $reason && $force -eq 0 ]]; then
    die "$SLUG/$session has $reason (use -f to remove anyway)"
  fi
  remove_sandbox "$SLUG" "$session"
}

cmd_gc() {
  local days=7 apply=0
  while (($#)); do
    case $1 in
      --days) days=${2:?missing days}; shift 2 ;;
      --yes) apply=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  local cutoff dir slug session last reason
  cutoff=$(($(date +%s) - days * 86400))
  for dir in "$SANDBOX_DIR"/*/*/; do
    [[ -e $dir/.git ]] || continue
    dir=${dir%/}
    session=$(basename "$dir")
    slug=$(basename "$(dirname "$dir")")
    last=$(stat -c %Y "$dir/.git/sbx-last-used" 2>/dev/null || stat -c %Y "$dir")
    ((last < cutoff)) || continue
    reason=$(unsaved_work "$dir")
    if [[ -n $reason ]]; then
      echo "keep    $slug/$session ($reason)"
    elif ((apply)); then
      remove_sandbox "$slug" "$session"
      echo "removed $slug/$session"
    else
      echo "would remove $slug/$session"
    fi
  done
  if ((apply)); then docker image prune --force >/dev/null; fi
}

main() {
  local subcommand=${1:-}
  [[ -n $subcommand ]] || { usage; exit 1; }
  shift
  case $subcommand in
    build) cmd_build "$@" ;;
    shell) cmd_shell "$@" ;;
    ls) cmd_ls "$@" ;;
    path) cmd_path "$@" ;;
    fetch) cmd_fetch "$@" ;;
    rm) cmd_rm "$@" ;;
    gc) cmd_gc "$@" ;;
    -h | --help | help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
